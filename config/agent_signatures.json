    {"cmdline_contains": "langchain", "kind": "agent_framework", "severity": "medium"},
    {"cmdline_contains": "autogen", "kind": "agent_framework", "severity": "medium"},
    {"cmdline_contains": "crewai", "kind": "agent_framework", "severity": "medium"},
    {"cmdline_contains": "openclaw", "kind": "autonomous_agent", "severity": "high"},
